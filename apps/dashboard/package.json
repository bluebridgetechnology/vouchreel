{
  "name": "@vouchreel/dashboard",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env lib/jobs/main.ts",
    "worker:build": "node scripts/build-worker.mjs",
    "worker:start": "node dist/worker.mjs",
    "worker:video": "tsx --env-file-if-exists=.env lib/jobs/main-video.ts",
    "worker:video:start": "node dist/video-worker.mjs",
    "lint": "eslint . && node scripts/check-tokens.mjs && node scripts/check-contrast.mjs",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed-events.mjs",
    "admin:grant": "node scripts/grant-admin.mjs",
    "db:seed:demo": "node scripts/seed-demo-user.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "build:e2e": "NEXT_PUBLIC_APP_URL=http://localhost:3101 next build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify-json/solar": "^1.2.13",
    "@iconify/utils": "^3.1.7",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@vouchreel/video": "*",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dodopayments": "^2.50.0",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^3.3.19",
    "next": "latest",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "postcss": "latest",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vitest": "^5.0.0"
  }
}
