# Database
DATABASE_URL=postgresql://vouchreel:vouchreel@localhost:5432/vouchreel

# BetterAuth
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional for dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage
STORAGE_PROVIDER=s3
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Dodo Payments
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base URL used in embed snippets (must include the scheme, no trailing slash).
# Leave empty to serve the widget from the app itself: <app>/widget/<embed-key>.js
NEXT_PUBLIC_WIDGET_URL=http://localhost:3000

# Email (password reset, team invites, notification emails)
# Without RESEND_API_KEY emails are logged to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Vouchreel <no-reply@vouchreel.com>

# Scheduled jobs (webhook retries, review sync). REQUIRED in production: the cron endpoints
# refuse to run without it. Generate with: openssl rand -hex 32
CRON_SECRET=

# Rate limiting and client IP
# Number of reverse proxies in front of the app (Vercel/nginx = 1, Cloudflare + nginx = 2, none = 0)
TRUSTED_PROXY_HOPS=1
# Optional: shared rate-limit counters across instances (required on Vercel / multiple replicas)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Dev only: allow webhooks to localhost / private addresses (ignored in production)
ALLOW_PRIVATE_WEBHOOK_TARGETS=false


# Observability (all optional)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# LOG_LEVEL=info
# LOG_FORMAT=json
# METRICS_TOKEN=

# Require new accounts to confirm their email before signing in (needs RESEND_API_KEY; run
# `npm run auth:verify-existing -w @vouchreel/dashboard -- --apply` first so existing accounts keep working)
# REQUIRE_EMAIL_VERIFICATION=true

# Content Security Policy stage: report-only (default), enforce, or off. See docs/deployment.md.
# CSP_MODE=report-only
