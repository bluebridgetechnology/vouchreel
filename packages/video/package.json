{
  "name": "@vouchreel/video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remotion review-video templates and render service",
  "exports": {
    ".": "./src/registry.ts",
    "./render": "./src/render.ts",
    "./entry": "./src/entry.tsx",
    "./player": "./src/player.tsx",
    "./font-faces": "./src/lib/font-faces.ts"
  },
  "scripts": {
    "studio": "remotion studio src/entry.tsx",
    "preview": "tsx scripts/preview.ts",
    "bundle": "tsx scripts/bundle.ts",
    "test": "vitest run",
    "test:render": "VIDEO_RENDER_TESTS=1 vitest run render.integration",
    "typecheck": "tsc --noEmit",
    "swatches:compare": "tsx scripts/compare-swatches.mts",
    "fonts:measure": "tsx scripts/measure-fonts.mts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/lora": "5.2.8",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/outfit": "5.2.8",
    "@fontsource/playfair-display": "5.2.8",
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/fonts": "4.0.532",
    "@remotion/player": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "react": "*",
    "react-dom": "*",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "*",
    "playwright": "1.56.1",
    "tsx": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
