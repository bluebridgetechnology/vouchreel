# =============================================================================
# VouchReel production environment
#
# Copy to .env.production and fill in real values:
#   cp .env.production.example .env.production
#
# Used by docker-compose.production.yml. DATABASE_URL does NOT need to be set
# here — docker compose constructs it from the POSTGRES_* variables below.
#
# Never commit the filled-in .env.production. Keep it out of git and off any
# image layer (see .dockerignore).
# =============================================================================

# --- Postgres (consumed by the postgres service) ------------------------------
POSTGRES_USER=vouchreel
# Required — compose refuses to start without it. Use a long random value:
#   openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=vouchreel

# --- Auth ---------------------------------------------------------------------
# Required. Generate a fresh secret for production (do not reuse dev values):
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the deployed app, e.g. https://vouchreel.com
BETTER_AUTH_URL=

# --- Google OAuth (optional) --------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storage (S3-compatible object storage for avatars / testimonial media) ---
STORAGE_PROVIDER=s3
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=

# --- Stripe -------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Dodo Payments ------------------------------------------------------------
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# --- App (build-time: baked into the Next.js bundle during docker build) ------
# Public URL of the dashboard, e.g. https://vouchreel.com
NEXT_PUBLIC_APP_URL=
# Where embed snippets point to for vouchreel-widget.js.
# Leave empty to serve the widget from the dashboard itself
# (https://your-domain/widget/<embed-key>.js), or set a CDN base URL.
NEXT_PUBLIC_WIDGET_URL=

# Email (password reset, team invites, notification emails). Required for password reset to work.
RESEND_API_KEY=
EMAIL_FROM=Vouchreel <no-reply@vouchreel.com>

# Scheduled jobs (webhook retries, review sync). REQUIRED in production: the cron endpoints
# refuse to run without it. Generate with: openssl rand -hex 32
CRON_SECRET=

# Rate limiting and client IP
# Number of reverse proxies in front of the app (Vercel/nginx = 1, Cloudflare + nginx = 2, none = 0)
TRUSTED_PROXY_HOPS=1
# Optional: shared rate-limit counters across instances (required on Vercel / multiple replicas)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Dev only: allow webhooks to localhost / private addresses (ignored in production)
ALLOW_PRIVATE_WEBHOOK_TARGETS=false


# Self-hosted observability (optional; see docs/deployment.md, "Self-hosted observability").
# Only needed when docker-compose.observability.yml is used. Generate secrets with: openssl rand -hex 32
METRICS_TOKEN=
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_DOMAIN=http://localhost:8001
GRAFANA_ADMIN_PASSWORD=
# After GlitchTip has created your project, paste its DSN here and restart app, worker, video-worker
SENTRY_DSN=

# Require new accounts to confirm their email (see docs/deployment.md, "Email verification")
REQUIRE_EMAIL_VERIFICATION=false
# Platform admins must use two-factor sign-in. Leave unset (required). Set to false only to switch the rule off.
# REQUIRE_ADMIN_2FA=false

# Content Security Policy: report-only first, then enforce (see docs/deployment.md, "Content Security Policy")
CSP_MODE=report-only
